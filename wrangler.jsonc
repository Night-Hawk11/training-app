{
  // Deploys the built app (dist/) as a Cloudflare static-assets Worker.
  // No server code — `assets` serves the files, and single-page-application
  // handling serves index.html for client-side routes (/session, /history, …).
  "name": "training-app",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
